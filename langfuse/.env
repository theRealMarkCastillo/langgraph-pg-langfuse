# Local-only demo settings for the Langfuse stack (read by docker compose).
# Headless init: creates an org, project, API keys and a login user on first boot.
LANGFUSE_INIT_ORG_ID=demo-org
LANGFUSE_INIT_ORG_NAME=Demo Org
LANGFUSE_INIT_PROJECT_ID=langgraph-demo
LANGFUSE_INIT_PROJECT_NAME=LangGraph Demo
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-demo
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-demo
LANGFUSE_INIT_USER_EMAIL=demo@example.com
LANGFUSE_INIT_USER_NAME=Demo User
LANGFUSE_INIT_USER_PASSWORD=demo-password-123
TELEMETRY_ENABLED=false
