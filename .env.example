# Copy to .env and adjust:  cp .env.example .env
# .env is git-ignored; never commit real API keys.

# LangGraph state store (see ./docker-compose.yml)
POSTGRES_URI=postgresql://langgraph:langgraph@localhost:5433/langgraph?sslmode=disable

# Langfuse (see ./langfuse/.env — these local demo keys are created there on first boot)
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local-demo
LANGFUSE_SECRET_KEY=sk-lf-local-demo

# OpenAI-compatible chat endpoint. Leave OPENAI_BASE_URL unset to run offline with the scripted model.
# Examples: http://localhost:11434/v1 (Ollama), http://localhost:8000/v1 (vLLM), https://api.openai.com/v1
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=llama3.1
# OPENAI_TEMPERATURE=0.2
# OPENAI_MAX_TOKENS=300
# OPENAI_TIMEOUT=60
# OPENAI_MAX_RETRIES=2

# Embeddings for demos.memory (optional). Unset: memory recalls all of a user's memories.
# Set: memories are embedded into pgvector and recalled by meaning.
# The embedding endpoint can differ from chat (e.g. DeepSeek chat + OpenAI embeddings);
# BASE_URL / API_KEY fall back to the chat ones. DIMS is auto-detected if unset.
# Switching embedding models later requires ./scripts/reset.sh (drops stored vectors).
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_API_KEY=
# OPENAI_EMBEDDING_DIMS=1536
